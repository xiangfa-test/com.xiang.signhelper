# ---------------------------------------------------------------- 构建产物
*.iml
.gradle
.kotlin
/local.properties
/.idea
.DS_Store
/build
/app/build

# ---------------------------------------------------------------- 签名密钥
keystore.properties
*.jks
*.keystore
*.p12

# ---------------------------------------------------------------- 不进版本库的"非构建"内容
#
# 原则：和项目构建自身无关的文件都不进版本库。
#   dist/   构建产物（APK），每次构建都变、体积大
#   _shots/ 设备截图
#   _tools/ 一次性脚本
/dist/
/_shots/
/_tools/

# 注意：maven-local/ **要**进版本库 —— libxposed 的 102 AAR 是构建必需依赖，
# 离线环境没有它就编译不了。

# ---------------------------------------------------------------- 崩溃/临时
/captures
.externalNativeBuild
.cxx
*.hprof
*.log
